<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- 兼容链：CLR 按顺序取第一个"机器上已安装"的声明。v4.0 无 sku = 任意 4.x；
         sku 行按从低到高排列仅为可读性。代码只用 4.6.2 就有的 API（HttpClient、
         JavaScriptSerializer、WPF、P/Invoke），声明降到 4.7.2 覆盖 Win10 1803+ 原生环境，
         免去在 Win10 上安装 .NET Framework 的死循环。 -->
    <supportedRuntime version="v4.0" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!-- WPF per-monitor DPI changes are opt-in on .NET Framework 4.8; without
         this the window stays at 96 dpi when it lands on the 125% screen. On
         runtimes older than 4.8 the switch is simply ignored (harmless). -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
